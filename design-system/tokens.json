{
  "$description": "Starter tokens. The structure and the names are the point. Replace the values for each project. This is the only file where raw values may appear.",
  "primitive": {
    "color": {
      "neutral": {
        "0": "#FFFFFF",
        "50": "#F6F7F9",
        "100": "#EDEFF2",
        "300": "#C4C9D1",
        "500": "#6B7280",
        "700": "#374151",
        "900": "#111827"
      },
      "blue": {
        "50": "#EFF6FF",
        "600": "#1D4ED8",
        "700": "#1E40AF"
      },
      "red": {
        "50": "#FEF2F2",
        "700": "#B91C1C"
      },
      "green": {
        "50": "#F0FDF4",
        "700": "#15803D"
      },
      "amber": {
        "50": "#FFFBEB",
        "800": "#92400E"
      }
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "default": "{primitive.color.neutral.0}",
        "subtle": "{primitive.color.neutral.50}",
        "inverse": "{primitive.color.neutral.900}"
      },
      "content": {
        "primary": "{primitive.color.neutral.900}",
        "secondary": "{primitive.color.neutral.700}",
        "inverse": "{primitive.color.neutral.0}",
        "link": "{primitive.color.blue.700}"
      },
      "border": {
        "default": "{primitive.color.neutral.300}",
        "strong": "{primitive.color.neutral.500}"
      },
      "action": {
        "primary": "{primitive.color.blue.700}",
        "on-primary": "{primitive.color.neutral.0}"
      },
      "feedback": {
        "error-surface": "{primitive.color.red.50}",
        "error-content": "{primitive.color.red.700}",
        "success-surface": "{primitive.color.green.50}",
        "success-content": "{primitive.color.green.700}",
        "warning-surface": "{primitive.color.amber.50}",
        "warning-content": "{primitive.color.amber.800}",
        "info-surface": "{primitive.color.blue.50}",
        "info-content": "{primitive.color.blue.700}"
      },
      "focus": {
        "ring": "{primitive.color.blue.600}"
      }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "size": {
    "target-min": "24px",
    "target-comfortable": "44px"
  },
  "typography": {
    "font-family-body": "system-ui, sans-serif",
    "font-family-heading": "system-ui, sans-serif",
    "size": {
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px"
    },
    "line-height": {
      "body": "1.5",
      "heading": "1.2"
    },
    "weight": {
      "regular": "400",
      "bold": "700"
    }
  },
  "contrastPairs": [
    { "text": "semantic.color.content.primary", "on": "semantic.color.surface.default", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.content.secondary", "on": "semantic.color.surface.default", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.content.link", "on": "semantic.color.surface.default", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.content.inverse", "on": "semantic.color.surface.inverse", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.action.on-primary", "on": "semantic.color.action.primary", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.feedback.error-content", "on": "semantic.color.feedback.error-surface", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.feedback.success-content", "on": "semantic.color.feedback.success-surface", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.feedback.warning-content", "on": "semantic.color.feedback.warning-surface", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.feedback.info-content", "on": "semantic.color.feedback.info-surface", "min": 4.5, "kind": "text" },
    { "text": "semantic.color.border.strong", "on": "semantic.color.surface.default", "min": 3, "kind": "non-text" },
    { "text": "semantic.color.focus.ring", "on": "semantic.color.surface.default", "min": 3, "kind": "non-text" }
  ]
}
