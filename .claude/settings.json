{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.next/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
